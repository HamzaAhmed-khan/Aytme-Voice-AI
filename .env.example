# 🔐 AYTME API - ENVIRONMENT CONFIGURATION
# ==============================================================
# SECURITY: NEVER commit .env files to version control
# Copy this to .env and fill in your values
# Production: Use AWS Secrets Manager or similar secure storage
# ==============================================================

# Application Environment
ENVIRONMENT=development  # development | staging | production

# ============== 🔐 CRITICAL SECRETS (REQUIRED) ==============

# JWT Secret Key for token generation
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be 64+ characters for production
# Rotate quarterly and update SECRET_KEY_VERSION when changed
SECRET_KEY=your-64-character-random-jwt-secret-key-here-cannot-be-exposed

# Secret key version (increment when rotating keys)
SECRET_KEY_VERSION=1

# ============== DATABASE ==============
DATABASE_URL=postgresql+asyncpg://aytme_user:secure_password@localhost:5432/aytme_prod

# ============== CACHE & QUEUING ==============
REDIS_URL=redis://localhost:6379/0

# ============== LIVEKIT (Real-time Video/Audio) ==============
# Get from: https://cloud.livekit.io/projects
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-livekit-secret-key-64-chars-minimum
LIVEKIT_URL=wss://your-project.livekit.cloud

# ============== OPENAI (AI Transcription & Translation) ==============
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY

# ============== STRIPE (Payments) ==============
# Get from: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ============== AWS S3 (File Storage) ==============
S3_BUCKET=aytme-storage-prod
S3_ENDPOINT=
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ============== FRONTEND & CORS ==============
# IMPORTANT (iOS/macOS Safari): microphone/audio capture requires HTTPS origin.
# Use your real HTTPS frontend domain in production and mobile device testing.
FRONTEND_URL=https://your-frontend-domain.com
# Comma-separated exact origins allowed to call API.
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# ============== EMAIL NOTIFICATIONS ==============
SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ============== ERROR TRACKING ==============
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/YOUR_PROJECT_ID
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============== DEVELOPMENT OPTIONS ==============
EMULATE_STORAGE=true
DEBUG=false
